@model FashionStore.Models.Category
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sửa Danh Mục";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card mb-4">
            <div class="admin-card-header d-flex justify-content-between align-items-center">
                <h6 class="admin-card-title">@ViewData["Title"]</h6>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Quay lại danh sách</a>
            </div>
            <div class="p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="CategoryId" />
                    <input type="hidden" asp-for="ImageUrl" />

                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label asp-for="CategoryName" class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
                                <input asp-for="CategoryName" class="form-control" id="catName" onkeyup="generateSlug()" />
                                <span asp-validation-for="CategoryName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Slug" class="form-label fw-semibold">Đường dẫn tĩnh (Slug) <span class="text-danger">*</span></label>
                                <input asp-for="Slug" class="form-control bg-light" id="catSlug" />
                                <span asp-validation-for="Slug" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="mb-3">
                                <label asp-for="DisplayOrder" class="form-label fw-semibold">Thứ tự hiển thị</label>
                                <input asp-for="DisplayOrder" type="number" class="form-control" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Thay đổi hình ảnh đại diện</label>
                                <input type="file" name="imageFile" class="form-control" accept="image/*" id="imageInput" />
                                <div class="small text-muted mt-1">Để trống nếu không muốn thay đổi ảnh</div>
                                <div class="mt-2 text-center">
                                    <img id="imagePreview" src="@(Model.ImageUrl ?? "https://via.placeholder.com/200?text=Ch%C6%B0a+c%C3%B3+%E1%BA%A3nh")" alt="Preview" class="img-fluid rounded border" style="max-height: 150px; display: block;" />
                                </div>
                            </div>

                            <div class="form-check form-switch mb-4">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck">
                                <label class="form-check-label" for="isActiveCheck">Hiển thị danh mục</label>
                            </div>

                            <button type="submit" class="btn btn-primary-custom w-100 py-2">CẬP NHẬT DANH MỤC</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('imageInput').addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById('imagePreview');
                    img.src = e.target.result;
                }
                reader.readAsDataURL(e.target.files[0]);
            }
        });

        function generateSlug() {
            let str = document.getElementById('catName').value;
            str = str.toLowerCase();
            str = str.replace(/(à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ)/g, 'a');
            str = str.replace(/(è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ)/g, 'e');
            str = str.replace(/(ì|í|ị|ỉ|ĩ)/g, 'i');
            str = str.replace(/(ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ)/g, 'o');
            str = str.replace(/(ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ)/g, 'u');
            str = str.replace(/(ỳ|ý|ỵ|ỷ|ỹ)/g, 'y');
            str = str.replace(/(đ)/g, 'd');
            str = str.replace(/([^a-z0-9-\s])/g, '');
            str = str.replace(/(\s+)/g, '-');
            str = str.replace(/-+/g, '-');
            str = str.replace(/^-+|-+$/g, '');
            document.getElementById('catSlug').value = str;
        }
    </script>
}
