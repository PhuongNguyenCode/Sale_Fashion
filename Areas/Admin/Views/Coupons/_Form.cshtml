@model FashionStore.Models.Coupon
<div class="row justify-content-center"><div class="col-lg-9"><div class="admin-card mb-4">
    <div class="admin-card-header"><h6 class="admin-card-title">@ViewData["Title"]</h6><a asp-action="Index" class="btn btn-sm btn-outline-secondary">Quay lại</a></div>
    <div class="p-4"><form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input asp-for="CouponId" type="hidden" />
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="CouponCode" class="form-label fw-semibold">Mã giảm giá</label><input asp-for="CouponCode" class="form-control text-uppercase" /><span asp-validation-for="CouponCode" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="DiscountType" class="form-label fw-semibold">Loại giảm</label><select asp-for="DiscountType" class="form-select"><option value="Percent">Phần trăm (%)</option><option value="Amount">Số tiền (đ)</option></select></div>
            <div class="col-md-6"><label asp-for="DiscountValue" class="form-label fw-semibold">Giá trị giảm</label><input asp-for="DiscountValue" type="number" min="0" class="form-control" /><span asp-validation-for="DiscountValue" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="UsageLimit" class="form-label fw-semibold">Giới hạn lượt dùng</label><input asp-for="UsageLimit" type="number" min="0" class="form-control" /><div class="form-text">Để trống nếu không giới hạn.</div></div>
            <div class="col-md-6"><label asp-for="MinOrderAmount" class="form-label fw-semibold">Đơn tối thiểu (đ)</label><input asp-for="MinOrderAmount" type="number" min="0" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="MaxDiscountAmount" class="form-label fw-semibold">Giảm tối đa (đ)</label><input asp-for="MaxDiscountAmount" type="number" min="0" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="StartDate" class="form-label fw-semibold">Ngày bắt đầu</label><input asp-for="StartDate" type="date" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="EndDate" class="form-label fw-semibold">Ngày kết thúc</label><input asp-for="EndDate" type="date" class="form-control" /><span asp-validation-for="EndDate" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="Description" class="form-label fw-semibold">Mô tả</label><textarea asp-for="Description" rows="3" class="form-control"></textarea></div>
            <div class="col-12"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Kích hoạt mã sau khi lưu</label></div></div>
        </div>
        <button class="btn btn-primary-custom mt-4 px-4" type="submit">@ViewData["SubmitText"]</button>
    </form></div>
</div></div></div>
