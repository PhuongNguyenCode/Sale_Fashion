@model FashionStore.Models.Order
@{
    Layout = "_Layout";
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.OrderCode;
}

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Order Items -->
        <div class="admin-card mb-4">
            <div class="admin-card-header">
                <h6 class="admin-card-title">Sản Phẩm Trong Đơn</h6>
            </div>
            <div class="admin-card-body">
                <table class="table admin-table mb-0">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">Phân loại</th>
                            <th class="text-center">SL</th>
                            <th class="text-center">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td class="fw-semibold">@item.ProductName</td>
                                <td class="text-center text-muted small">@item.ColorName / @item.SizeName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-center">@item.UnitPrice.ToString("N0")đ</td>
                                <td class="text-end fw-bold">@item.SubTotal.ToString("N0")đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="4" class="text-end">Tạm tính:</td>
                            <td class="text-end fw-semibold">@Model.SubTotal.ToString("N0")đ</td>
                        </tr>
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr>
                                <td colspan="4" class="text-end text-success">Giảm giá:</td>
                                <td class="text-end text-success fw-semibold">-@Model.DiscountAmount.ToString("N0")đ</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="4" class="text-end">Phí vận chuyển:</td>
                            <td class="text-end fw-semibold">@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("N0") + "đ")</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end fw-bold fs-6">Tổng cộng:</td>
                            <td class="text-end fw-bold fs-6 text-danger">@Model.TotalAmount.ToString("N0")đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Order Info -->
        <div class="admin-card mb-4">
            <div class="admin-card-header"><h6 class="admin-card-title">Thông Tin Đơn Hàng</h6></div>
            <div class="p-4">
                <dl class="row mb-0" style="font-size: 14px;">
                    <dt class="col-5 text-muted">Mã đơn:</dt>
                    <dd class="col-7 fw-bold">#@Model.OrderCode</dd>
                    <dt class="col-5 text-muted">Ngày đặt:</dt>
                    <dd class="col-7">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-5 text-muted">Thanh toán:</dt>
                    <dd class="col-7">@Model.PaymentMethod</dd>
                    <dt class="col-5 text-muted">Trạng thái TT:</dt>
                    <dd class="col-7">
                        <span class="badge @(Model.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">
                            @(Model.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                        </span>
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Customer Info -->
        <div class="admin-card mb-4">
            <div class="admin-card-header"><h6 class="admin-card-title">Thông Tin Giao Hàng</h6></div>
            <div class="p-4" style="font-size: 14px;">
                <div class="fw-bold mb-1">@Model.FullName</div>
                <div class="text-muted mb-1"><i class="fas fa-phone me-2"></i>@Model.Phone</div>
                <div class="text-muted mb-1"><i class="fas fa-envelope me-2"></i>@Model.Email</div>
                <div class="text-muted"><i class="fas fa-map-marker-alt me-2"></i>@Model.Address, @Model.City</div>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="mt-3 p-2 bg-light rounded small text-muted">
                        <i class="fas fa-sticky-note me-1"></i> @Model.Note
                    </div>
                }
            </div>
        </div>

        <!-- Update Status -->
        <div class="admin-card">
            <div class="admin-card-header"><h6 class="admin-card-title">Cập Nhật Trạng Thái</h6></div>
            <div class="p-4">
                <div class="mb-3">
                    <span class="fw-semibold">Trạng thái hiện tại: </span>
                    <span class="badge badge-@Model.Status.ToString().ToLower() px-3 py-2 ms-1">
                        @(Model.Status switch {
                            FashionStore.Models.OrderStatus.Pending => "Chờ xử lý",
                            FashionStore.Models.OrderStatus.Confirmed => "Đã xác nhận",
                            FashionStore.Models.OrderStatus.Processing => "Đang xử lý",
                            FashionStore.Models.OrderStatus.Shipping => "Đang giao",
                            FashionStore.Models.OrderStatus.Delivered => "Đã giao",
                            FashionStore.Models.OrderStatus.Cancelled => "Đã hủy",
                            _ => Model.Status.ToString()
                        })
                    </span>
                </div>

                @if (Model.Status != FashionStore.Models.OrderStatus.Delivered && Model.Status != FashionStore.Models.OrderStatus.Cancelled)
                {
                    <form asp-area="Admin" asp-controller="Orders" asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <div class="mb-3">
                            <select name="newStatus" class="form-select">
                                @if (Model.Status == FashionStore.Models.OrderStatus.Pending)
                                {
                                    <option value="Confirmed">✅ Xác nhận đơn hàng</option>
                                    <option value="Cancelled">❌ Hủy đơn hàng</option>
                                }
                                @if (Model.Status == FashionStore.Models.OrderStatus.Confirmed)
                                {
                                    <option value="Processing">📦 Chuyển sang Đang xử lý</option>
                                    <option value="Cancelled">❌ Hủy đơn hàng</option>
                                }
                                @if (Model.Status == FashionStore.Models.OrderStatus.Processing)
                                {
                                    <option value="Shipping">🚚 Chuyển sang Đang giao hàng</option>
                                    <option value="Cancelled">❌ Hủy đơn hàng</option>
                                }
                                @if (Model.Status == FashionStore.Models.OrderStatus.Shipping)
                                {
                                    <option value="Delivered">✅ Xác nhận Đã giao thành công</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-dark w-100">Cập Nhật</button>
                    </form>
                }
                else
                {
                    <p class="text-muted small mb-0">Đơn hàng đã ở trạng thái cuối cùng.</p>
                }
            </div>
        </div>
    </div>
</div>
