@model IEnumerable<FashionStore.Models.Order>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản Lý Đơn Hàng";
}

<div class="admin-card mb-4">
    <div class="admin-card-header">
        <h6 class="admin-card-title">Danh Sách Đơn Hàng</h6>
    </div>
    <div class="p-4 border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <input type="text" name="q" value="@ViewBag.Search" class="form-control" placeholder="Tìm kiếm theo mã đơn, tên, SĐT...">
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Pending" selected="@(ViewBag.Status == "Pending")">Chờ xử lý</option>
                    <option value="Confirmed" selected="@(ViewBag.Status == "Confirmed")">Đã xác nhận</option>
                    <option value="Processing" selected="@(ViewBag.Status == "Processing")">Đang xử lý</option>
                    <option value="Shipping" selected="@(ViewBag.Status == "Shipping")">Đang giao hàng</option>
                    <option value="Delivered" selected="@(ViewBag.Status == "Delivered")">Đã giao</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-dark w-100"><i class="fas fa-search me-1"></i> Tìm kiếm</button>
            </div>
        </form>
    </div>

    <div class="admin-card-body">
        <div class="table-responsive">
            <table class="table admin-table mb-0">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><span class="fw-bold">#@order.OrderCode</span></td>
                                <td>
                                    <div class="fw-semibold">@order.FullName</div>
                                    <div class="text-muted small">@order.Phone</div>
                                </td>
                                <td class="text-muted small">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold">@order.TotalAmount.ToString("N0")đ</td>
                                <td>
                                    <span class="badge @(order.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">
                                        @(order.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-@order.Status.ToString().ToLower() px-3 py-2">
                                        @(order.Status switch {
                                            FashionStore.Models.OrderStatus.Pending => "Chờ xử lý",
                                            FashionStore.Models.OrderStatus.Confirmed => "Đã xác nhận",
                                            FashionStore.Models.OrderStatus.Processing => "Đang xử lý",
                                            FashionStore.Models.OrderStatus.Shipping => "Đang giao",
                                            FashionStore.Models.OrderStatus.Delivered => "Đã giao",
                                            FashionStore.Models.OrderStatus.Cancelled => "Đã hủy",
                                            _ => order.Status.ToString()
                                        })
                                    </span>
                                </td>
                                <td>
                                    <a asp-area="Admin" asp-controller="Orders" asp-action="Detail" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">Không tìm thấy đơn hàng nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="p-3 d-flex justify-content-between align-items-center border-top">
            <div class="text-muted small">Hiển thị trang @ViewBag.CurrentPage / @ViewBag.TotalPages</div>
            <nav>
                <ul class="pagination mb-0">
                    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i&status=@ViewBag.Status&q=@ViewBag.Search">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
