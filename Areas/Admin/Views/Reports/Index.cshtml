@model FashionStore.ViewModels.AdminSalesReportViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Báo Cáo Doanh Thu";
}
<div class="admin-card mb-4"><div class="p-4"><form method="get" class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label fw-semibold">Từ ngày</label><input name="fromDate" type="date" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-3"><label class="form-label fw-semibold">Đến ngày</label><input name="toDate" type="date" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-6 d-flex gap-2"><button class="btn btn-dark" type="submit"><i class="fas fa-filter me-1"></i>Xem báo cáo</button><a asp-action="ExportOrders" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" class="btn btn-outline-success"><i class="fas fa-file-csv me-1"></i>Xuất đơn hàng CSV</a></div></form></div></div>
<div class="row g-4 mb-4"><div class="col-md-3"><div class="kpi-card"><div class="kpi-value">@Model.DeliveredRevenue.ToString("N0")đ</div><div class="kpi-label">Doanh thu đã giao</div></div></div><div class="col-md-3"><div class="kpi-card"><div class="kpi-value">@Model.OrderCount</div><div class="kpi-label">Tổng đơn hàng</div></div></div><div class="col-md-3"><div class="kpi-card"><div class="kpi-value">@Model.DeliveredOrderCount</div><div class="kpi-label">Đơn đã giao</div></div></div><div class="col-md-3"><div class="kpi-card"><div class="kpi-value">@Model.AverageOrderValue.ToString("N0")đ</div><div class="kpi-label">Giá trị đơn đã giao TB</div><div class="small text-muted mt-2">@Model.CancelledOrderCount đơn đã hủy</div></div></div></div>
<div class="admin-card"><div class="admin-card-header"><h6 class="admin-card-title">Doanh thu theo ngày</h6><span class="text-muted small">@Model.FromDate.ToString("dd/MM/yyyy") – @Model.ToDate.ToString("dd/MM/yyyy")</span></div><div class="admin-card-body"><div class="table-responsive"><table class="table admin-table mb-0"><thead><tr><th>Ngày</th><th>Đơn đã giao</th><th class="text-end">Doanh thu</th></tr></thead><tbody>@foreach (var day in Model.DailyRevenue) { <tr><td>@day.Date.ToString("dd/MM/yyyy")</td><td>@day.Orders</td><td class="text-end fw-semibold">@day.Revenue.ToString("N0")đ</td></tr> }</tbody></table></div></div></div>
