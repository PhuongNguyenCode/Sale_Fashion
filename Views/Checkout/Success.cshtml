@model FashionStore.ViewModels.OrderSuccessViewModel
@{
    ViewData["Title"] = "Đặt Hàng Thành Công";
}

<div class="page-shell">
    <div class="success-card text-center">
        <p class="section-index">Đơn hàng</p>
        <h1 class="page-heading">Cảm ơn bạn!</h1>
        <p class="text-muted mb-4">
            Đơn hàng đã được ghi nhận và đang được xử lý.
        </p>

        <div class="cart-summary text-start mb-4">
            <div class="summary-row">
                <span>Mã đơn</span>
                <span>@Model.OrderCode</span>
            </div>
            <div class="summary-row">
                <span>Thanh toán</span>
                <span>@(Model.PaymentMethod == "COD" ? "COD" : Model.PaymentMethod)</span>
            </div>
            <div class="summary-row total">
                <span>Tổng</span>
                <span>@Model.TotalAmount.ToString("N0")đ</span>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/Product" class="btn-outline-custom">Tiếp tục mua</a>
            <a href="/" class="fs-btn">Về trang chủ <span class="arrow">→</span></a>
        </div>
    </div>
</div>
