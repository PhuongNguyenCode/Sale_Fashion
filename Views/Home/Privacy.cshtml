@{
    ViewData["Title"] = "Về chúng tôi";
}

<div class="page-shell about-page">
    <p class="section-index" data-reveal>Về chúng tôi</p>
    <h1 class="page-heading" data-reveal>Câu chuyện FashionStore.</h1>
    <p class="about-lede" data-reveal>
        FashionStore giữ nguyên cách bạn mua — và kể lại như một campaign:
        chữ lớn, ảnh chậm, chuyển động có chủ đích.
    </p>

    <div class="about-grid">
        <figure class="about-media" data-clip>
            <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=1400&auto=format&fit=crop" alt="Editorial studio">
        </figure>
        <div class="about-copy">
            <p data-reveal>Mùa 26 được dựng như một bộ sưu tập: danh mục là chương, sản phẩm là điểm nhấn, giỏ hàng là phòng thử đồ.</p>
            <p data-reveal>Chúng tôi chọn sự chỉn chu trong từng hình ảnh, khoảng trắng và chuyển động.</p>
            <a class="fs-btn" href="/Product">Khám phá bộ sưu tập <span class="arrow">→</span></a>
        </div>
    </div>
</div>
