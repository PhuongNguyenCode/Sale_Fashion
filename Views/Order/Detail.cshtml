@model FashionStore.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-receipt"></i> Chi tiết đơn hàng</h2>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <!-- Order Status -->
    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5>Mã đơn hàng: <strong>#@Model.OrderCode</strong></h5>
                    <p class="text-muted mb-0">
                        <i class="far fa-calendar"></i> Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark fs-6">Chờ xử lý</span>
                    }
                    else if (Model.Status == "Confirmed")
                    {
                        <span class="badge bg-info fs-6">Đã xác nhận</span>
                    }
                    else if (Model.Status == "Shipping")
                    {
                        <span class="badge bg-primary fs-6">Đang giao hàng</span>
                    }
                    else if (Model.Status == "Delivered")
                    {
                        <span class="badge bg-success fs-6">Đã giao hàng</span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="badge bg-danger fs-6">Đã hủy</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Products List -->
        <div class="col-md-8">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Sản phẩm</h5>
                </div>
                <div class="card-body">
                    @foreach (var detail in Model.OrderDetails)
                    {
                        var hasReviewed = ViewData[$"HasReviewed_{detail.Variant?.Product?.ProductId}"] as bool? ?? false;
                        
                        <div class="row mb-3 pb-3 border-bottom">
                            <div class="col-md-2">
                                @if (!string.IsNullOrEmpty(detail.ProductImageUrl))
                                {
                                    <img src="@detail.ProductImageUrl" alt="@detail.ProductName" 
                                         class="img-fluid rounded">
                                }
                            </div>
                            <div class="col-md-6">
                                <h6>@detail.ProductName</h6>
                                <p class="text-muted mb-1">
                                    <small>
                                        Màu: @detail.ColorName | Size: @detail.SizeName
                                    </small>
                                </p>
                                <p class="mb-0">
                                    <small>Số lượng: x@detail.Quantity</small>
                                </p>

                                <!-- Review Button - Only show for Delivered orders -->
                                @if (Model.Status == "Delivered" && detail.Variant?.Product != null)
                                {
                                    if (hasReviewed)
                                    {
                                        <div class="mt-2">
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> Đã đánh giá
                                            </span>
                                            <a href="@Url.Action("MyReviews", "Review")" class="btn btn-sm btn-outline-secondary ms-2">
                                                Xem đánh giá
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-2">
                                            <a href="@Url.Action("Create", "Review", new { productId = detail.Variant.Product.ProductId, orderDetailId = detail.OrderDetailId })" 
                                               class="btn btn-sm btn-primary">
                                                <i class="fas fa-star"></i> Viết đánh giá
                                            </a>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="col-md-4 text-md-end">
                                <p class="mb-0">
                                    <strong>@detail.UnitPrice.ToString("N0") đ</strong>
                                </p>
                                <p class="text-muted mb-0">
                                    <small>Tổng: @detail.SubTotal.ToString("N0") đ</small>
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Order Info -->
        <div class="col-md-4">
            <!-- Customer Info -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Thông tin nhận hàng</h6>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>@Model.FullName</strong></p>
                    <p class="mb-1"><i class="fas fa-phone"></i> @Model.Phone</p>
                    <p class="mb-1"><i class="fas fa-envelope"></i> @Model.Email</p>
                    <p class="mb-0"><i class="fas fa-map-marker-alt"></i> @Model.Address, @Model.City</p>
                </div>
            </div>

            <!-- Payment Info -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Thanh toán</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính:</span>
                        <span>@Model.SubTotal.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Phí ship:</span>
                        <span>@Model.ShippingFee.ToString("N0") đ</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Giảm giá:</span>
                            <span>-@Model.DiscountAmount.ToString("N0") đ</span>
                        </div>
                    }
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Tổng cộng:</strong>
                        <strong class="text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</strong>
                    </div>
                    <hr>
                    <p class="mb-1">
                        <strong>Phương thức:</strong> @Model.PaymentMethod
                    </p>
                    @if (Model.Payment != null)
                    {
                        <p class="mb-0">
                            <strong>Trạng thái:</strong> 
                            @if (Model.Payment.Status == "Paid")
                            {
                                <span class="badge bg-success">Đã thanh toán</span>
                            }
                            else if (Model.Payment.Status == "Pending" || Model.Payment.Status == "Processing")
                            {
                                <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Model.Payment.Status</span>
                            }
                        </p>
                    }
                </div>
            </div>

            <!-- Actions -->
            @if (Model.Status == "Pending" || Model.Status == "Confirmed")
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#cancelModal">
                            <i class="fas fa-times-circle"></i> Hủy đơn hàng
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Note))
    {
        <div class="alert alert-info mt-3">
            <strong>Ghi chú:</strong> @Model.Note
        </div>
    }
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Hủy đơn hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Cancel" asp-route-orderCode="@Model.OrderCode" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p>Bạn có chắc muốn hủy đơn hàng này?</p>
                    <div class="mb-3">
                        <label for="reason" class="form-label">Lý do hủy</label>
                        <textarea class="form-control" id="reason" name="reason" rows="3" placeholder="Nhập lý do hủy đơn..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>
