@{
    ViewData["Title"] = "Payment Result";
    var status = ViewBag.Status as string ?? "pending";
    var orderCode = ViewBag.OrderCode as string ?? "";
    var totalAmount = ViewBag.TotalAmount as decimal? ?? 0;
    var paymentMethod = ViewBag.PaymentMethod as string ?? "";
    var transactionId = ViewBag.TransactionId as string;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body text-center p-5">
                    @if (status == "success")
                    {
                        <div class="mb-4">
                            <i class="fas fa-check-circle text-success" style="font-size: 80px;"></i>
                        </div>
                        <h2 class="text-success mb-3">Thanh toán thành công!</h2>
                        <p class="text-muted mb-4">Đơn hàng của bạn đã được thanh toán thành công.</p>
                    }
                    else if (status == "pending")
                    {
                        <div class="mb-4">
                            <i class="fas fa-clock text-warning" style="font-size: 80px;"></i>
                        </div>
                        <h2 class="text-warning mb-3">Đang chờ thanh toán</h2>
                        <p class="text-muted mb-4">Đơn hàng của bạn đang chờ thanh toán.</p>

                        @if ((paymentMethod == "BankTransfer" || paymentMethod == "Casso") && ViewBag.BankTransferInfo != null)
                        {
                            var bankInfo = ViewBag.BankTransferInfo as Dictionary<string, string>;
                            <div class="alert alert-info text-start mt-4">
                                <h5><i class="fas fa-university"></i> Thông tin chuyển khoản</h5>
                                <hr />
                                <p><strong>Ngân hàng:</strong> @bankInfo["BankName"]</p>
                                <p><strong>Số tài khoản:</strong> @bankInfo["AccountNumber"]</p>
                                <p><strong>Tên tài khoản:</strong> @bankInfo["AccountName"]</p>
                                @if (bankInfo.ContainsKey("Branch"))
                                {
                                    <p><strong>Chi nhánh:</strong> @bankInfo["Branch"]</p>
                                }
                                <p><strong>Số tiền:</strong> @bankInfo["Amount"] VNĐ</p>
                                <p><strong>Nội dung:</strong> <span class="badge bg-primary">@bankInfo["TransferContent"]</span></p>

                                @if (bankInfo.ContainsKey("QRCode") && !string.IsNullOrEmpty(bankInfo["QRCode"]))
                                {
                                    <div class="mt-3 text-center">
                                        <p class="text-muted mb-2"><i class="fas fa-qrcode"></i> Quét mã QR để chuyển khoản nhanh:</p>
                                        <img src="@bankInfo["QRCode"]" alt="QR Code" class="img-fluid border rounded" style="max-width: 300px;" />
                                        <p class="text-success mt-2"><small><i class="fas fa-check-circle"></i> Tự động xác nhận sau khi chuyển khoản (1-3 giây)</small></p>
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(bankInfo.GetValueOrDefault("QrCode")))
                                {
                                    <div class="mt-3 text-center">
                                        <p class="text-muted mb-2"><i class="fas fa-qrcode"></i> Quét mã QR để chuyển khoản nhanh:</p>
                                        <img src="@bankInfo["QrCode"]" alt="QR Code" class="img-fluid border rounded" style="max-width: 300px;" />
                                        <p class="text-success mt-2"><small><i class="fas fa-check-circle"></i> Tự động xác nhận sau khi chuyển khoản (1-3 giây)</small></p>
                                    </div>
                                }

                            </div>
                        }
                    }
                    else if (status == "failed")
                    {
                        <div class="mb-4">
                            <i class="fas fa-times-circle text-danger" style="font-size: 80px;"></i>
                        </div>
                        <h2 class="text-danger mb-3">Thanh toán thất bại</h2>
                        <p class="text-muted mb-4">Rất tiếc, thanh toán của bạn không thành công. Vui lòng thử lại.</p>
                    }
                    else
                    {
                        <div class="mb-4">
                            <i class="fas fa-exclamation-circle text-secondary" style="font-size: 80px;"></i>
                        </div>
                        <h2 class="text-secondary mb-3">Trạng thái không xác định</h2>
                        <p class="text-muted mb-4">@ViewBag.Message</p>
                    }

                    <div class="order-details mt-4 p-4 bg-light rounded">
                        <h5 class="mb-3">Thông tin đơn hàng</h5>
                        <div class="row text-start">
                            <div class="col-6">
                                <p><strong>Mã đơn hàng:</strong></p>
                                <p><strong>Tổng tiền:</strong></p>
                                <p><strong>Phương thức:</strong></p>
                                @if (!string.IsNullOrEmpty(transactionId))
                                {
                                    <p><strong>Mã giao dịch:</strong></p>
                                }
                            </div>
                            <div class="col-6 text-end">
                                <p>@orderCode</p>
                                <p>@totalAmount.ToString("N0") VNĐ</p>
                                <p>@paymentMethod</p>
                                @if (!string.IsNullOrEmpty(transactionId))
                                {
                                    <p>@transactionId</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg me-2">
                            <i class="fas fa-home"></i> Về trang chủ
                        </a>
                        @if (status == "success")
                        {
                            <a href="@Url.Action("Index", "Product")" class="btn btn-outline-primary btn-lg">
                                <i class="fas fa-shopping-bag"></i> Tiếp tục mua sắm
                            </a>
                        }
                        else if (status == "failed")
                        {
                            <a href="@Url.Action("Index", "Checkout")" class="btn btn-outline-danger btn-lg">
                                <i class="fas fa-redo"></i> Thử lại
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border: none;
            border-radius: 15px;
        }
        .order-details {
            border: 1px solid #dee2e6;
        }
    </style>
}

@if (status == "pending")
{
    @section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var orderCode = '@orderCode';
                if (!orderCode) return;

                var checkCount = 0;
                var maxChecks = 200; // 200 * 3s = 10 minutes max polling

                var interval = setInterval(function () {
                    checkCount++;
                    if (checkCount > maxChecks) {
                        clearInterval(interval);
                        return;
                    }

                    fetch('/payment/check-status/' + encodeURIComponent(orderCode))
                        .then(function (response) {
                            if (!response.ok) throw new Error('Network response error');
                            return response.json();
                        })
                        .then(function (data) {
                            if (data && data.isPaid) {
                                clearInterval(interval);
                                // Refresh page automatically when paid
                                window.location.reload();
                            }
                        })
                        .catch(function (err) {
                            console.log('Checking payment status...', err);
                        });
                }, 3000); // Poll every 3 seconds
            });

        </script>
    }
}
