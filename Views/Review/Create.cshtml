@{
    ViewData["Title"] = "Viết đánh giá";
    var product = ViewBag.Product as FashionStore.Models.Product;
    var orderDetailId = ViewBag.OrderDetailId as int?;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-star"></i> Viết đánh giá sản phẩm</h4>
                </div>
                <div class="card-body">
                    @if (product != null)
                    {
                        <!-- Thông tin sản phẩm -->
                        <div class="product-info mb-4 p-3 bg-light rounded">
                            <div class="row align-items-center">
                                <div class="col-md-3">
                                    <img src="@product.MainImageUrl" alt="@product.ProductName" class="img-fluid rounded">
                                </div>
                                <div class="col-md-9">
                                    <h5>@product.ProductName</h5>
                                    <p class="text-muted mb-0">
                                        <span class="badge bg-secondary">@product.Brand?.BrandName</span>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Form đánh giá -->
                        <form asp-action="Create" method="post">
                            <input type="hidden" name="productId" value="@product.ProductId" />
                            <input type="hidden" name="orderDetailId" value="@orderDetailId" />
                            @Html.AntiForgeryToken()

                            <!-- Rating -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">Đánh giá của bạn <span class="text-danger">*</span></label>
                                <div class="star-rating">
                                    <input type="radio" id="star5" name="rating" value="5" required />
                                    <label for="star5" title="5 sao"><i class="fas fa-star"></i></label>
                                    
                                    <input type="radio" id="star4" name="rating" value="4" />
                                    <label for="star4" title="4 sao"><i class="fas fa-star"></i></label>
                                    
                                    <input type="radio" id="star3" name="rating" value="3" />
                                    <label for="star3" title="3 sao"><i class="fas fa-star"></i></label>
                                    
                                    <input type="radio" id="star2" name="rating" value="2" />
                                    <label for="star2" title="2 sao"><i class="fas fa-star"></i></label>
                                    
                                    <input type="radio" id="star1" name="rating" value="1" />
                                    <label for="star1" title="1 sao"><i class="fas fa-star"></i></label>
                                </div>
                                <small class="text-muted">Nhấn vào sao để chọn đánh giá</small>
                            </div>

                            <!-- Nhận xét -->
                            <div class="mb-4">
                                <label for="comment" class="form-label fw-bold">Nhận xét của bạn</label>
                                <textarea class="form-control" id="comment" name="comment" rows="5" 
                                          placeholder="Chia sẻ trải nghiệm của bạn về sản phẩm này..." maxlength="1000"></textarea>
                                <small class="text-muted">Tối đa 1000 ký tự</small>
                            </div>

                            <!-- Buttons -->
                            <div class="d-flex justify-content-between">
                                <a href="@Url.Action("Detail", "Product", new { slug = product.Slug })" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left"></i> Quay lại
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-paper-plane"></i> Gửi đánh giá
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>

            <!-- Lưu ý -->
            <div class="alert alert-info mt-3">
                <i class="fas fa-info-circle"></i> 
                <strong>Lưu ý:</strong> Đánh giá của bạn sẽ được kiểm duyệt trước khi hiển thị công khai.
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .star-rating {
            direction: rtl;
            display: inline-flex;
            gap: 5px;
        }
        
        .star-rating input[type="radio"] {
            display: none;
        }
        
        .star-rating label {
            font-size: 2rem;
            color: #ddd;
            cursor: pointer;
            transition: color 0.2s;
        }
        
        .star-rating input[type="radio"]:checked ~ label,
        .star-rating label:hover,
        .star-rating label:hover ~ label {
            color: #ffc107;
        }
        
        .product-info {
            border: 1px solid #dee2e6;
        }
    </style>
}

@section Scripts {
    <script>
        // Hiển thị số sao đã chọn
        document.querySelectorAll('.star-rating input[type="radio"]').forEach(input => {
            input.addEventListener('change', function() {
                console.log('Đã chọn ' + this.value + ' sao');
            });
        });
    </script>
}
